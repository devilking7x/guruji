# Guruji server env vars (NO real values — fill in your own at deploy time)

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nebius Token Factory API key (leave empty for tests; required for real chats)
LLM_API_KEY=
# Model served by the Token Factory / OpenAI-compatible endpoint
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Vision-capable model for /api/copycheck (image input)
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Pricing used by the demo-budget meter (USD per 1M tokens)
LLM_PRICE_INPUT_PER_1M=0.2
LLM_PRICE_OUTPUT_PER_1M=0.6

# Per-IP daily demo budget (USD). Over-quota chats get 429.
GURUJI_IP_DAILY_CAP_USD=0.15

# Auto-memory after each chat turn (1 = on). Set "0" to disable.
GURUJI_AUTO_REMEMBER=1

# Set "1" in tests: all LLM calls return canned Hindi replies, zero network.
LLM_MOCK=0

# HTTP port
PORT=3001
